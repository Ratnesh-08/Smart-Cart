# Smart Cart AI Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git. Add .env to .gitignore.

# Server Port
PORT=3000

# Supabase Project Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase Service Role Key (Used ONLY by ESP32 firmware / secure backend node process)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Google Gemini AI API Key (Used ONLY by server.js, NEVER exposed to client-side browser)
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
